# Shared HMAC secret used to sign/verify delivery webhooks between
# fake_platform and the main app. Must be identical on both sides.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# AES-GCM key (base64) for encrypting OAuth tokens at rest. If unset,
# crypto_utils.py generates one for the current process only (dev
# fallback) - set this explicitly for anything beyond local testing.
TOKEN_ENCRYPTION_KEY=